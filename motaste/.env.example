APP_NAME="MOTASTE"
APP_ENV=local
APP_KEY=
# ALWAYS false on production: true leaks stack traces, SQL, and file paths in
# error responses (visible in DevTools / to attackers).
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# DATABASE CREDENTIALS — least privilege (5.2)
#
# DEVELOPMENT (this file's defaults): SQLite, no credentials required.
#   DB_CONNECTION=sqlite
#
# PRODUCTION: use a DEDICATED application account, never root/superuser.
#   Create the roles with database/security/least_privilege.sql, then set:
#
#   DB_CONNECTION=pgsql
#   DB_HOST=your-db-host
#   DB_PORT=5432
#   DB_DATABASE=production
#   DB_USERNAME=motaste_app            # dedicated app role (DML only)
#   DB_PASSWORD=<strong unique password>
#
#   Migrations run at deploy time with the schema-owner role (NOT the app role
#   and NOT a superuser):
#     DB_USERNAME=motaste_migrator php artisan migrate --force
#
#   Development and production use SEPARATE .env files / credential values.
#   Never commit .env to the repository.
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
#DB_HOST=127.0.0.1
#DB_PORT=3306
DB_DATABASE=database/database.sqlite
# Production example — dedicated app account (not root):
#DB_USERNAME=motaste_app
#DB_PASSWORD=CHANGE_ME

#
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Session cookie flags. These are the deployment defaults; production must keep
# SESSION_HTTP_ONLY=true (JS cannot read the cookie) and
# SESSION_SECURE_COOKIE=true (cookie only sent over HTTPS).
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google reCAPTCHA v2 (staff login CAPTCHA) — see README
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=

# Staff-login brute-force limits. Each defaults to the value shown and is
# clamped to a minimum of 1, so a misconfiguration cannot disable a limit.
STAFF_LOGIN_MAX_ATTEMPTS=5          # failed attempts before an account locks
STAFF_LOGIN_LOCKOUT_MINUTES=2       # window those failures are counted over
STAFF_LOGIN_IP_MAX_ATTEMPTS=20      # failed attempts before an IP locks
STAFF_LOGIN_IP_LOCKOUT_MINUTES=2    # window for the IP-scoped counter
# Failed attempts (per account or per IP, within the lockout window) before the
# CAPTCHA checkbox is demanded. Default 3 (the 4th submit is gated).
STAFF_LOGIN_CAPTCHA_THRESHOLD=3

# Staff session lifetimes. Defaults shown; each is clamped to a minimum of 1.
STAFF_SESSION_LIFETIME_SECONDS=2592000  # persistent session cookie (30 days)
STAFF_SESSION_TOKEN_TTL_DAYS=30         # issued session token lifetime
# Inactivity logout: a session unused for this long is dropped even though its
# cookie/token are still valid (closing the browser signs out 30 minutes later).
STAFF_SESSION_IDLE_TIMEOUT_SECONDS=1800

VITE_APP_NAME="${APP_NAME}"
